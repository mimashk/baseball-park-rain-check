{
  "name": "@baseball/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/generateArticles.ts && next dev",
    "build": "tsx scripts/generateArticles.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "images:convert": "tsx scripts/convertImages.ts",
    "images:svgo": "svgo -f public/teams --config svgo.config.mjs",
    "preview": "tsx scripts/generateArticles.ts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "export NEXT_PUBLIC_SITE_URL=https://baseballraincheck.jp && tsx scripts/generateArticles.ts && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "next": "^16.1.6",
    "next-mdx-remote-client": "^2.1.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "wrangler": "^4.70.0"
  }
}

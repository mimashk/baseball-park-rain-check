generator client {
  provider = "prisma-client"
  output   = "./generate"
}

datasource db {
  provider = "mysql"
}

enum GameStatus {
  scheduled
  in_progress
  completed
  cancelled
}

model ScheduledGame {
  id        String     @id @default(uuid()) @db.Char(36)
  date      DateTime
  category  String     @db.VarChar(32)   // GameCategory (日本語文字列)
  homeTeam  String     @db.VarChar(32)   // BaseballTeam (日本語文字列)
  awayTeam  String     @db.VarChar(32)
  ballPark  String     @db.VarChar(80)   // BallPark名（カタログ表記）
  status    GameStatus @default(scheduled)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("scheduled_games")
  @@index([date])
}

model PastGameRecord {
  id        Int      @id @default(autoincrement())
  date      DateTime
  homeTeam  String   @db.VarChar(32)  // BaseballTeam (日本語)
  awayTeam  String   @db.VarChar(32)
  ballPark  String   @db.VarChar(80)  // BallPark名
  cancelled Boolean  // GameCancelled.fromBoolean の元になる値
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("past_game_records")
  @@index([date])
  @@unique([date, homeTeam, awayTeam])
}

model BallParkHourlyWeatherForecast {
  id                         Int      @id @default(autoincrement())
  date                       DateTime
  weatherCode                Int
  temperature                Float                // TemperatureCelsius
  precipitationProbability   Float                // 0-100 (%)
  rainFall                   Float                // mm
  ballParkId                 Int                  // BallPark.id()
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("ball_park_hourly_weather_forecasts")
  @@unique([ballParkId, date]) // 同一球場・同一時刻を一意に
  @@index([date])
}

model BallParkDailyWeatherForecast {
  id                         Int      @id @default(autoincrement())
  date                       DateTime
  weatherCode                Int
  temperatureMin             Float
  temperatureMax             Float
  precipitationProbability   Float
  rainFall                   Float
  ballParkId                 Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("ball_park_daily_weather_forecasts")
  @@unique([ballParkId, date]) // 同一球場・同一日を一意に
  @@index([date])
}

model BallParkObservedHourlyWeather {
  id                         Int      @id @default(autoincrement())
  date                       DateTime
  temperature                Float
  rainfallOccurred           Boolean
  rainFall                   Float
  ballParkId                 Int                  // BallPark.id()
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("ball_park_observed_hourly_weathers")
  @@unique([ballParkId, date]) // 同一球場・同一日を一意に
  @@index([date])
}

model CancellationModel {
  id           String   @id @default(cuid())
  version      String
  featureOrder Json     // string[]
  coefficients Json     // number[]
  intercept    Float
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cancellation_models")
  @@unique([version])
}
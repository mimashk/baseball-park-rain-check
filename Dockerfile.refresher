# syntax=docker/dockerfile:1

FROM node:22-slim AS builder
WORKDIR /app

COPY package*.json ./
COPY apps/http/refresher/package*.json ./apps/http/refresher/
COPY packages/package*.json ./packages/
RUN npm ci

COPY . .
RUN npm run -w @baseball/refresher build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

COPY package*.json ./
COPY apps/http/refresher/package*.json ./apps/http/refresher/
COPY packages/package*.json ./packages/
RUN npm ci --omit=dev

COPY --from=builder /app/apps/http/refresher/dist ./dist
CMD ["node", "dist/apps/http/refresher/src/main.js"]